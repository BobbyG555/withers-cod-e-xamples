
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Arena = workspace:WaitForChild("BlobArena")

local Max_food = 150
local Food_respawn = 0.3
local Food_count = 0

local Golden_chance = 2
local Moving_chance = 12
local Burst_chance = 5

local Food_folder = Instance.new("Folder")
Food_folder.Name = "BlobFood"
Food_folder.Parent = workspace

local Food_types = {
    {
        worth = 1,
        size = 0.7,
        color = Color3.fromRGB(255, 220, 70),
        chance = 55
    },
    {
        worth = 3,
        size = 1,
        color = Color3.fromRGB(70, 255, 120),
        chance = 30
    },
    {
        worth = 5,
        size = 1.3,
        color = Color3.fromRGB(255, 80, 180),
        chance = 15
    }
}

local function Random_pos()
    local Arena_size = Arena.Size
    local Arena_pos = Arena.Position

    local X = math.random(
        math.ceil(-Arena_size.X / 2 + 5),
        math.floor(Arena_size.X / 2 - 5)
    )

    local Z = math.random(
        math.ceil(-Arena_size.Z / 2 + 5),
        math.floor(Arena_size.Z / 2 - 5)
    )

    return Vector3.new(
        Arena_pos.X + X,
        Arena_pos.Y + Arena_size.Y / 2 + 1.5,
        Arena_pos.Z + Z
    )
end

local function Pick_food()
    local Roll = math.random(1, 100)
    local Total = 0

    for _, Info in pairs(Food_types) do
        Total += Info.chance

        if Roll <= Total then
            return Info
        end
    end

    return Food_types[1]
end

local function Spawn_food()
    if Food_count >= Max_food then return end

    local Food_info = Pick_food()
    local Is_golden = math.random(1, 100) <= Golden_chance

    local Worth = Food_info.worth
    local Size = Food_info.size
    local Color = Food_info.color

    if Is_golden then
        Worth = 25
        Size = 1.8
        Color = Color3.fromRGB(255, 190, 0)
    end

    local Food = Instance.new("Part")
    Food.Name = Is_golden and "GoldenFood" or "Food"
    Food.Shape = Enum.PartType.Ball
    Food.Size = Vector3.new(0.1, 0.1, 0.1)
    Food.Position = Random_pos()
    Food.Anchored = true
    Food.CanCollide = false
    Food.CanTouch = true
    Food.Material = Enum.Material.Neon
    Food.Color = Color
    Food.Parent = Food_folder

    Food_count += 1

    local Collected = false
    local Original_pos = Food.Position

    local Appear = TweenService:Create(
        Food,
        TweenInfo.new(0.25),
        {
            Size = Vector3.new(Size, Size, Size)
        }
    )

    Appear:Play()

    if Is_golden then
        local Light = Instance.new("PointLight")
        Light.Color = Color
        Light.Brightness = 2
        Light.Range = 12
        Light.Parent = Food

        local Particles = Instance.new("ParticleEmitter")
        Particles.Rate = 8
        Particles.Lifetime = NumberRange.new(0.4, 0.8)
        Particles.Speed = NumberRange.new(1, 3)
        Particles.SpreadAngle = Vector2.new(180, 180)
        Particles.Color = ColorSequence.new(Color)
        Particles.Parent = Food

        task.spawn(function()
            while Food.Parent and not Collected do
                TweenService:Create(
                    Light,
                    TweenInfo.new(0.5),
                    {Brightness = 4}
                ):Play()

                task.wait(0.5)

                if not Food.Parent then break end

                TweenService:Create(
                    Light,
                    TweenInfo.new(0.5),
                    {Brightness = 1}
                ):Play()

                task.wait(0.5)
            end
        end)
    end

    if math.random(1, 100) <= Moving_chance then
        task.spawn(function()
            while Food.Parent and not Collected do
                local Offset = Vector3.new(
                    math.random(-4, 4),
                    0,
                    math.random(-4, 4)
                )

                local Move = TweenService:Create(
                    Food,
                    TweenInfo.new(
                        math.random(10, 20) / 10,
                        Enum.EasingStyle.Sine
                    ),
                    {Position = Original_pos + Offset}
                )

                Move:Play()
                Move.Completed:Wait()

                task.wait(0.2)
            end
        end)
    end

    Food.Touched:Connect(function(Hit)
        if Collected then return end

        local Char = Hit:FindFirstAncestorOfClass("Model")
        if not Char then return end

        local Plr = Players:GetPlayerFromCharacter(Char)
        if not Plr then return end

        local Hum = Char:FindFirstChildOfClass("Humanoid")
        if not Hum or Hum.Health <= 0 then return end

        if not Char:FindFirstChild("BlobBody") then return end

        Collected = true
        Food.CanTouch = false

        local Old_mass = Plr:GetAttribute("Mass") or 10
        Plr:SetAttribute("Mass", Old_mass + Worth)

        local Eaten = Plr:GetAttribute("FoodEaten") or 0
        Plr:SetAttribute("FoodEaten", Eaten + 1)

        if Is_golden then
            local Flash = Instance.new("Part")
            Flash.Shape = Enum.PartType.Ball
            Flash.Size = Vector3.new(1, 1, 1)
            Flash.Position = Food.Position
            Flash.Anchored = true
            Flash.CanCollide = false
            Flash.CanTouch = false
            Flash.Material = Enum.Material.Neon
            Flash.Color = Color
            Flash.Transparency = 0.3
            Flash.Parent = workspace

            TweenService:Create(
                Flash,
                TweenInfo.new(0.4),
                {
                    Size = Vector3.new(8, 8, 8),
                    Transparency = 1
                }
            ):Play()

            Debris:AddItem(Flash, 0.5)
        end

        local Disappear = TweenService:Create(
            Food,
            TweenInfo.new(0.15),
            {
                Size = Vector3.new(0.1, 0.1, 0.1),
                Transparency = 1
            }
        )

        Disappear:Play()
        Disappear.Completed:Wait()

        Food:Destroy()
    end)
end

Players.PlayerAdded:Connect(function(Plr)
    Plr:SetAttribute("Mass", 10)
    Plr:SetAttribute("FoodEaten", 0)

    local Stats = Instance.new("Folder")
    Stats.Name = "leaderstats"
    Stats.Parent = Plr

    local Mass = Instance.new("IntValue")
    Mass.Name = "Mass"
    Mass.Value = 10
    Mass.Parent = Stats

    Plr:GetAttributeChangedSignal("Mass"):Connect(function()
        Mass.Value = math.floor(Plr:GetAttribute("Mass") or 10)
    end)

    Plr.CharacterAdded:Connect(function(Char)
        local Hum = Char:WaitForChild("Humanoid")

        Hum.Died:Connect(function()
            local Current_mass = Plr:GetAttribute("Mass") or 10

            if Current_mass > 10 then
                local Lost = math.floor(Current_mass * 0.25)

                Plr:SetAttribute(
                    "Mass",
                    math.max(10, Current_mass - Lost)
                )
            end
        end)
    end)
end)

for I = 1, 80 do
    Spawn_food()
    task.wait(0.01)
end

task.spawn(function()
    while true do
        task.wait(15)

        if math.random(1, 100) <= Burst_chance then
            local Amount = math.random(5, 15)

            for I = 1, Amount do
                if Food_count >= Max_food then break end

                Spawn_food()
                task.wait(0.05)
            end
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(10)

        for _, Food in pairs(Food_folder:GetChildren()) do
            if Food:IsA("BasePart") then
                local Pos = Food.Position
                local Center = Arena.Position
                local Half = Arena.Size / 2

                if math.abs(Pos.X - Center.X) > Half.X
                    or math.abs(Pos.Z - Center.Z) > Half.Z then

                    Food:Destroy()
                end
            end
        end
    end
end)

Food_folder.ChildRemoved:Connect(function()
    Food_count = math.max(0, Food_count - 1)
end)

while true do
    task.wait(Food_respawn)

    if Food_count < Max_food then
        Spawn_food()
    end
end
